server {
  server_name ${FORECAST_DOMAIN} weather.wapp.wii.com; 
  listen 80;
  listen [::]:80;
  client_max_body_size 500M;

  location ~ /(.*)/(.*)/forecast.bin {
    alias /var/www/forecast/$1/$2/forecast.bin;
  }

  location ~ /(.*)/(.*)/short.bin {
    alias /var/www/forecast/$1/$2/short.bin;
  }
}

server {
    listen 80;
    server_name weather.wii.rc24.xyz;

    location / {
        return 410;
    }
}
