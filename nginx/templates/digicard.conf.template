server {
  server_name ${DIGICARD_DOMAIN};
  listen 80;
  client_max_body_size 25M;


  location / {
    proxy_pass http://digicard:5000/;
  }

  location /assets/style.css {
    alias /var/www/digicard/templates/style.css;
  }

  location /assets/ {
    alias /var/www/digicard/assets/;
  }

  location /js {
    alias /var/www/digicard/js;
  }
}
