FORECAST_ASSETS_PATH=./data/forecast/assets
EVC_FILES_PATH=./data/evc
BOT_WADS_PATH=./data/bot/wads
WFC_PATCHES_PATH=./data/wfc/patches
DOMINOS_ASSETS_PATH=./data/dominos/assets
DOMINOS_ERRORS_PATH=./data/dominos/errors
DOMINOS_CERTS_PATH=./data/dominos/certs
