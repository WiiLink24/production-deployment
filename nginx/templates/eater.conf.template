server {
  server_name eater.wiilink.ca;
  listen 80;
  listen [::]:80;
  client_max_body_size 500M;


  location / {
    proxy_set_header Host $host;
    proxy_pass http://just_eat:80/;
  }
}

server {
  server_name just-eat.wiilink.ca;
  listen 80;

  location / {
      proxy_pass http://just_eat:8080/;
  }
}