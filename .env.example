# External IP address that DNS server should be accessible over
# Also used within the DNS config to resolve Nintendo domains to your server
HOST_IP=

# Ports for DNS server and web server
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DNS_PORT=53

# Port for PostgreSQL (only exposed to localhost)
POSTGRES_PORT=2345

# Password for redis
REDIS_PASSWORD=

# Group ID of host user
# This is needed so read/write permissions work properly within containers
# If you do not know your GID, you can obtain it by running "id -g" in terminal
GID=

# Domains for services
ROOM_BASE_DOMAIN=prod.wiilink24.com
DEMAE_DOMAIN=food.wiilink24.com
DIGICAM_DOMAIN=cam-prod.wiilink24.com
DIGICARD_DOMAIN=card.wiilink24.com
