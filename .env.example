# External IP address that DNS server should be accessible over
# Also used within the DNS config to resolve Nintendo domains to your server
HOST_IP=

# Ports for DNS server and web server
NGINX_PORT=80
DNS_PORT=53

# Password for redis
REDIS_PASSWORD=

# Group ID of host user
# This is needed so read/write permissions work properly within containers
# If you do not know your GID, you can obtain it by running "id -g" in terminal
GID=

# Domains for services
ROOM_BASE_DOMAIN=dev.wiilink24.com
DEMAE_DOMAIN=demae.example.com
DIGICAM_DOMAIN=cam.example.com
DIGICARD_DOMAIN=card.example.com

# Folder paths for service data storage
# These should all be read/writable by the host user's group
ROOM_ASSETS_PATH=
DIGICARD_PATH=
FOOD_ASSETS_PATH=
NC_ASSETS_PATH=
CMOC_ASSETS_PATH=
ANNOUNCEMENTS_PATH=
CAM_TEMPLATES_PATH=
CAM_ORDERS_PATH=
NEWS_ASSETS_PATH=
NEWS_CACHE_PATH=
FORECAST_ASSETS_PATH=
EVC_FILES_PATH=
BOT_WADS_PATH=
WFC_PATCHES_PATH=
DOMINOS_ASSETS_PATH=
DOMINOS_ERRORS_PATH=
DOMINOS_CERTS_PATH=
PATCHER_FILES_PATH=
CFH_FILES_PATH=