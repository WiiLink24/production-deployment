server {
    listen 80;
    server_name ${NEWS_DOMAIN};
    root /var/www/news;

    location / {
    }

    location = / {
        return 302 https://wiilink.ca/services/news;
    }

    # Japanese
    location ~ /v2/0/(.*)/news.bin.(.*) {
        try_files /v2/0/001/news.bin.$2 =404;
    }

    # Spanish
    location ~ /v2/4/(.*)/news.bin.(.*) {
        try_files /v2/4/105/news.bin.$2 =404;
    }

    # German
    location ~ /v2/2/(.*)/news.bin.(.*) {
        try_files /v2/2/078/news.bin.$2 =404;
    }

    # French
    location ~ /v2/3/(.*)/news.bin.(.*) {
        try_files /v2/3/077/news.bin.$2 =404;
    }

    # Italian
    location ~ /v2/5/(.*)/news.bin.(.*) {
        try_files /v2/5/083/news.bin.$2 =404;
    }

    # Dutch
    location ~ /v2/6/(.*)/news.bin.(.*) {
        try_files /v2/6/094/news.bin.$2 =404;
    }

    # English
    location ~ /v2/(.*)/(00[8-9]|0[1-4][0-9]|05[0-2])/news.bin.(.*) {
        try_files /v2/1/$2/news.bin.$3 /v2/1/049/news.bin.$3 =404;
    }

    location ~ /v2/(.*)/(06[4-9]|0[7-9][0-9]|11[0-9]|12[0-1])/news.bin.(.*) {
        try_files /v2/1/$2/news.bin.$3 /v2/1/110/news.bin.$3 =404; 
    }

    location ~ /v2/(.*)/(12[8-9]|1[3-5][0-9]|160)/news.bin.(.*) {
        try_files /v2/1/$2/news.bin.$3 /v2/1/136/news.bin.$3 =404;
    }

    location ~ /v2/(.*)/(16[8-9]|17[0-7])/news/bin/(.*) {
        try_files /v2/1/$2/news.bin.$3 /v2/1/169/news.bin.$3 =404;
    }

    location ~ /v2/(.*)/(.*)/news.bin.(.*) {
        try_files /v2/$1/$2/news.bin.$3 /v2/1/049/news.bin.$3 =404;
    }
}

